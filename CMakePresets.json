{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Config",
      "description": "Default build using vcpkg toolchain (win64/linux64)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        }
      }
    },
    {
      "name": "run",
      "displayName": "Run",
      "description": "Debug build without tests",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with tests enabled",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized release build",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug32",
      "displayName": "Debug Win32",
      "description": "Debug build for Windows 32-bit (x86) with tests",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build32",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON"
      },
      "architecture": {
        "value": "x86",
        "strategy": "set"
      }
    },
    {
      "name": "linux64",
      "displayName": "Linux x64",
      "description": "Build for Linux 64-bit (use on Linux or WSL)",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-linux64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux32",
      "displayName": "Linux x86",
      "description": "Build for Linux 32-bit (requires g++-multilib, use on Linux). Uses FetchContent for deps.",
      "binaryDir": "${sourceDir}/build-linux32",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "CMAKE_C_FLAGS": "-m32",
        "CMAKE_CXX_FLAGS": "-m32",
        "CMAKE_EXE_LINKER_FLAGS": "-m32",
        "CMAKE_SHARED_LINKER_FLAGS": "-m32"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "run",
      "displayName": "Run Build",
      "configurePreset": "run"
    },
    {
      "name": "debug",
      "displayName": "Debug Build",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "displayName": "Release Build",
      "configurePreset": "release"
    },
    {
      "name": "debug32",
      "displayName": "Debug Win32 Build",
      "configurePreset": "debug32"
    },
    {
      "name": "linux64",
      "displayName": "Linux x64 Build",
      "configurePreset": "linux64"
    },
    {
      "name": "linux32",
      "displayName": "Linux x86 Build",
      "configurePreset": "linux32"
    }
  ]
}

