{
  "name": "picoc",
  "displayName": "PicoC Language Support",
  "publisher": "picoc-dev-team",
  "description": "Syntax highlighting and compile support for the PicoC programming language",
  "version": "0.1.0",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "main": "./out/extension.js",
  "activationEvents": ["onLanguage:picoc"],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  },
  "configurationDefaults": {
    "editor.tokenColorCustomizations": {
      "textMateRules": [
          {
            "scope": "comment.line.number-sign.picoc",
            "settings": { "foreground": "#6A9955" }
          },
          {
            "scope": "comment.block.picoc",
            "settings": { "foreground": "#6A9955" }
          },
          {
            "scope": "keyword.control.picoc",
            "settings": { "foreground": "#C586C0" }
          },
          {
            "scope": "keyword.other.sizeof.picoc",
            "settings": { "foreground": "#569CD6" }
          },
          {
            "scope": "storage.modifier.picoc",
            "settings": { "foreground": "#569CD6" }
          },
          {
            "scope": "storage.type.picoc",
            "settings": { "foreground": "#569CD6" }
          },
          {
            "scope": "storage.type.primitive.picoc",
            "settings": { "foreground": "#569CD6" }
          },
          {
            "scope": "constant.language.picoc",
            "settings": { "foreground": "#569CD6" }
          },
          {
            "scope": "string.quoted.double.picoc",
            "settings": { "foreground": "#CE9178" }
          },
          {
            "scope": "constant.character.escape.picoc",
            "settings": { "foreground": "#D7BA7D" }
          },
          {
            "scope": "constant.numeric.float.picoc",
            "settings": { "foreground": "#B5CEA8" }
          },
          {
            "scope": "constant.numeric.integer.picoc",
            "settings": { "foreground": "#B5CEA8" }
          },
          {
            "scope": "entity.name.function.picoc",
            "settings": { "foreground": "#DCDCAA" }
          },
          {
            "scope": "variable.other.picoc",
            "settings": { "foreground": "#9CDCFE" }
          },
          {
            "scope": "keyword.operator.comparison.picoc",
            "settings": { "foreground": "#D4D4D4" }
          },
          {
            "scope": "keyword.operator.arithmetic.picoc",
            "settings": { "foreground": "#D4D4D4" }
          },
          {
            "scope": "keyword.operator.assignment.picoc",
            "settings": { "foreground": "#D4D4D4" }
          },
          {
            "scope": "keyword.operator.logical.picoc",
            "settings": { "foreground": "#D4D4D4" }
          },
          {
            "scope": "punctuation.accessor.picoc",
            "settings": { "foreground": "#D4D4D4" }
          },
          {
            "scope": "punctuation.terminator.picoc",
            "settings": { "foreground": "#D4D4D4" }
          },
          {
            "scope": "punctuation.separator.colon.picoc",
            "settings": { "foreground": "#D4D4D4" }
          },
          {
            "scope": "punctuation.separator.comma.picoc",
            "settings": { "foreground": "#D4D4D4" }
          },
          {
            "scope": "punctuation.section.parens.open.picoc",
            "settings": { "foreground": "#D4D4D4" }
          },
          {
            "scope": "punctuation.section.parens.close.picoc",
            "settings": { "foreground": "#D4D4D4" }
          },
          {
            "scope": "punctuation.section.braces.open.picoc",
            "settings": { "foreground": "#D4D4D4" }
          },
          {
            "scope": "punctuation.section.braces.close.picoc",
            "settings": { "foreground": "#D4D4D4" }
          }
        ]
      }
  },
  "contributes": {
    "languages": [
      {
        "id": "picoc",
        "aliases": ["PicoC", "picoc"],
        "extensions": [".picoc"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "picoc",
        "scopeName": "source.picoc",
        "path": "./syntaxes/picoc.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "picoc.compile",
        "title": "PicoC: Compile Current File"
      }
    ],
    "configuration": {
      "title": "PicoC",
      "properties": {
        "picoc.compilerPath": {
          "type": "string",
          "default": "picoc",
          "description": "Path to the PicoC compiler executable"
        },
        "picoc.compileOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically compile when a .picoc file is saved"
        }
      }
    }
  }
}
