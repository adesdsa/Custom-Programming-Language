{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PicoC",
  "scopeName": "source.picoc",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#import_export" },
    { "include": "#control_keywords" },
    { "include": "#sizeof" },
    { "include": "#storage_modifiers" },
    { "include": "#variable_declarators" },
    { "include": "#primitive_types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#punctuation" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.picoc",
          "match": "#.*$"
        },
        {
          "name": "comment.block.picoc",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.picoc",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.picoc", "match": "\\\\." }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.picoc",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.picoc", "match": "\\\\." }
          ]
        }
      ]
    },
    "import_export": {
      "patterns": [
        {
          "name": "keyword.control.import.picoc",
          "match": "\\b(import|from|export)\\b"
        },
        {
          "name": "constant.language.wildcard.picoc",
          "match": "(?<=\\bimport\\s)\\*"
        }
      ]
    },
    "control_keywords": {
      "patterns": [
        {
          "name": "keyword.control.picoc",
          "match": "\\b(if|elif|else|for|while|break|continue|return|pass|and|or|not|xor)\\b"
        }
      ]
    },
    "sizeof": {
      "patterns": [
        {
          "name": "keyword.other.sizeof.picoc",
          "match": "\\bsizeof\\b"
        }
      ]
    },
    "storage_modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.picoc",
          "match": "\\b(const|readonly|global)\\b"
        }
      ]
    },
    "variable_declarators": {
      "patterns": [
        {
          "name": "storage.type.picoc",
          "match": "\\b(var|let)\\b"
        }
      ]
    },
    "primitive_types": {
      "patterns": [
        {
          "name": "storage.type.array.picoc",
          "match": "\\b(void|bool|unsigned|int|double|char|string)\\b(?=\\s*\\[)"
        },
        {
          "name": "storage.type.primitive.picoc",
          "match": "\\b(void|bool|unsigned|int|double|char|string)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.picoc",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.picoc",
          "match": "-?\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.picoc",
          "match": "-?\\b\\d+\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.accessor.picoc", "match": "->" },
        { "name": "punctuation.terminator.picoc", "match": ";" },
        { "name": "punctuation.separator.colon.picoc", "match": ":" },
        { "name": "punctuation.separator.comma.picoc", "match": "," },
        { "name": "punctuation.section.parens.open.picoc", "match": "\\(" },
        { "name": "punctuation.section.parens.close.picoc", "match": "\\)" },
        { "name": "punctuation.section.braces.open.picoc", "match": "\\{" },
        { "name": "punctuation.section.braces.close.picoc", "match": "\\}" },
        { "name": "punctuation.section.brackets.open.picoc", "match": "\\[" },
        { "name": "punctuation.section.brackets.close.picoc", "match": "\\]" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.comparison.picoc", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.arithmetic.picoc", "match": "//|[+\\-*/%]" },
        { "name": "keyword.operator.assignment.picoc", "match": "=" },
        { "name": "keyword.operator.logical.picoc", "match": "!" }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.picoc",
          "match": "\\b([a-zA-Z_]\\w*)\\s*(?=\\()"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.picoc",
          "match": "\\b[a-zA-Z_]\\w*\\b"
        }
      ]
    }
  }
}
