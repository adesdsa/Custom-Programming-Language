{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PicoC",
  "scopeName": "source.picoc",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.picoc",
          "match": "#.*$"
        },
        {
          "name": "comment.block.picoc",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.picoc",
          "match": "\\b(if|elif|else|for|while|break|continue|return|pass)\\b"
        },
        {
          "name": "keyword.operator.logical.picoc",
          "match": "\\b(and|or|not|xor)\\b"
        },
        {
          "name": "storage.modifier.picoc",
          "match": "\\b(const|readonly|global)\\b"
        },
        {
          "name": "storage.type.picoc",
          "match": "\\b(var|let)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.picoc",
          "match": "\\b(void|bool|unsigned|int|double)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.picoc",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.picoc",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.picoc",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.picoc",
          "match": "-?\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.picoc",
          "match": "-?\\b\\d+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.picoc",
          "match": "\\b([a-zA-Z_]\\w*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.picoc",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.picoc",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.picoc",
          "match": "//|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.picoc",
          "match": "="
        },
        {
          "name": "keyword.operator.logical.picoc",
          "match": "!"
        }
      ]
    }
  }
}