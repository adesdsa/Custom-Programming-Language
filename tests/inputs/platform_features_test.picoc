# Platform Features Test - exercises all string/builtin features
# Run with stdin: "hello" + newline + "42" + newline + "3.14" + newline
# Expected: exit 0, various printed output

main(void) -> int
{
    # 1. string type
    let s: string = "hello";
    println(s);

    # 2. string addition (literals)
    println("he" + "llo");

    # 3. string addition (variables)
    let a: string = "he";
    let b: string = "llo";
    println(a + b);

    # 4. string addition (string returning function)
    println(str_concat("wo", "rld"));

    # 5. string and char addition
    let c: char = 'X';
    println('A' + "bc");
    println("Grade: " + c);

    # 6. char to string casting (literal)
    let t: string = 'a';
    println(t);

    # 7. char to string casting (variable)
    let ch: char = 'Z';
    let u: string = ch;
    println(u);

    # 8. substr builtin
    println(substr("hello", 1, 3));

    # 9. str_len (size) builtin
    println(str_len("hello"));

    # 10. readln builtin
    let line: string = readln();
    println(line);
    println(str_len(line));

    # 11. read_int builtin
    let i: int = read_int();
    println(i);

    # 12. read_double builtin
    let d: double = read_double();
    println(d);

    # 13. char_at builtin
    println(char_at("hello", 0));
    println(char_at("test", 2));

    return 0;
}
